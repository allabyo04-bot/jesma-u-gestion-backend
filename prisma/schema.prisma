// ============================================================
// JESMA U - Gestion Commerciale
// Schéma basé sur les règles de "La Pointure", adapté :
//  - pas de gestion des pointures
//  - fournisseur optionnel à la réception de stock
//  - cartes cadeaux RÉUTILISABLES (code-barres fixe, dénomination fixe)
//  - listes cadeaux (accès interne + accès public par lien)
//  - vente par lecteur code-barre (génération/impression si absent)
//  - stock multi-emplacement (entrepôt <-> boutique) avec transferts
//  - fidélité : cadeau après 10 achats consécutifs >= 20 000f
//  - vente à crédit (sans date d'échéance, suivi du montant restant)
//  - retours/échanges (échange obligatoire, jamais de remboursement espèces)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// UTILISATEURS & RÔLES
// ------------------------------------------------------------

enum RoleUtilisateur {
  ADMIN       // Victoria
  CAISSIER
}

model Utilisateur {
  id            Int             @id @default(autoincrement())
  nomUtilisateur String         @unique
  pin           String          // haché
  nomComplet    String
  role          RoleUtilisateur
  actif         Boolean         @default(true)
  createdAt     DateTime        @default(now())

  ventes            Vente[]
  depenses          Depense[]
  mouvementsStock   MouvementStock[]
  demandesRemise    DemandeRemise[] @relation("DemandeurRemise")
  remisesApprouvees DemandeRemise[] @relation("ApprobateurRemise")
  activationsCarte  CarteCadeauCycle[] @relation("ActivateurCycle")
  offresValidees    ListeCadeauCarteUtilisee[] @relation("ValidateurOffre")
  reglementsCredit  ReglementCredit[]
  echanges          Echange[]
}

// ------------------------------------------------------------
// FAMILLES & SOUS-FAMILLES
// ------------------------------------------------------------

model Famille {
  id            Int           @id @default(autoincrement())
  nom           String        @unique
  actif         Boolean       @default(true)

  sousFamilles  SousFamille[]
  articles      Article[]
}

model SousFamille {
  id          Int      @id @default(autoincrement())
  nom         String
  familleId   Int
  famille     Famille  @relation(fields: [familleId], references: [id])
  actif       Boolean  @default(true)

  articles    Article[]

  @@unique([familleId, nom])
}

// ------------------------------------------------------------
// ARTICLES & STOCK (sans pointures)
// ------------------------------------------------------------

model Article {
  id              Int          @id @default(autoincrement())
  reference       String       @unique
  codeBarre       String?      @unique
  codeBarreGenere Boolean      @default(false)
  codeInterne     String?      @unique
  designation     String
  photoUrl        String?
  familleId       Int?
  famille         Famille?     @relation(fields: [familleId], references: [id])
  sousFamilleId   Int?
  sousFamille     SousFamille? @relation(fields: [sousFamilleId], references: [id])
  prixAchat       Decimal      @default(0)
  prixVente       Decimal
  stockActuel     Int          @default(0)
  seuilAlerte     Int          @default(5)
  actif           Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  ligneVentes        LigneVente[]
  mouvementsStock    MouvementStock[]
  receptions         LigneReception[]
  ligneListeCadeau   LigneListeCadeau[]
  stocksEmplacement  StockEmplacement[]
  lignesTransfert    LigneTransfertStock[]
  lignesEchangeRepris  LigneEchangeRepris[]
  lignesEchangeNouveau LigneEchangeNouveau[]
}

// ------------------------------------------------------------
// EMPLACEMENTS & STOCK MULTI-SITE (entrepôt <-> boutique)
// ------------------------------------------------------------

enum TypeLieu {
  ENTREPOT   // lieu de stockage principal
  BOUTIQUE   // point de vente
}

model Lieu {
  id     Int      @id @default(autoincrement())
  nom    String   @unique // ex: "Entrepôt principal", "Boutique Jesma U"
  type   TypeLieu
  actif  Boolean  @default(true)

  stocks                StockEmplacement[]
  receptions            Reception[]
  mouvementsStock       MouvementStock[]
  transfertsSource      TransfertStock[] @relation("LieuSource")
  transfertsDestination TransfertStock[] @relation("LieuDestination")
  ventes                Vente[]
  echanges              Echange[]
}

// Quantité réelle par article et par emplacement (somme = Article.stockActuel)
model StockEmplacement {
  id        Int     @id @default(autoincrement())
  articleId Int
  article   Article @relation(fields: [articleId], references: [id])
  lieuId    Int
  lieu      Lieu    @relation(fields: [lieuId], references: [id])
  quantite  Int     @default(0)

  @@unique([articleId, lieuId])
}

// Réception de stock — fournisseur optionnel, arrive dans un lieu donné (en général l'entrepôt)
model Reception {
  id            Int       @id @default(autoincrement())
  fournisseur   String?   // optionnel : saisi ou non selon le cas
  reference     String?
  lieuId        Int
  lieu          Lieu      @relation(fields: [lieuId], references: [id])
  dateReception DateTime  @default(now())
  notes         String?
  createdAt     DateTime  @default(now())

  lignes        LigneReception[]
}

model LigneReception {
  id            Int       @id @default(autoincrement())
  receptionId   Int
  reception     Reception @relation(fields: [receptionId], references: [id])
  articleId     Int
  article       Article   @relation(fields: [articleId], references: [id])
  quantite      Int
  prixAchat     Decimal   // met à jour Article.prixAchat pour le calcul de marge
}

// Transfert de stock entrepôt -> boutique (ou inverse si besoin)
enum StatutTransfert {
  VALIDE
  ANNULE
}

model TransfertStock {
  id                Int             @id @default(autoincrement())
  reference         String          @unique
  lieuSourceId      Int
  lieuSource        Lieu            @relation("LieuSource", fields: [lieuSourceId], references: [id])
  lieuDestinationId Int
  lieuDestination   Lieu            @relation("LieuDestination", fields: [lieuDestinationId], references: [id])
  statut            StatutTransfert @default(VALIDE)
  dateTransfert     DateTime        @default(now())
  notes             String?
  createdAt         DateTime        @default(now())

  lignes            LigneTransfertStock[]
}

model LigneTransfertStock {
  id          Int            @id @default(autoincrement())
  transfertId Int
  transfert   TransfertStock @relation(fields: [transfertId], references: [id])
  articleId   Int
  article     Article        @relation(fields: [articleId], references: [id])
  quantite    Int
}

enum TypeMouvementStock {
  ENTREE_RECEPTION
  SORTIE_VENTE
  ANNULATION_VENTE
  CORRECTION_INVENTAIRE
  RETOUR_CLIENT
  TRANSFERT_SORTIE
  TRANSFERT_ENTREE
}

model MouvementStock {
  id            Int                @id @default(autoincrement())
  articleId     Int
  article       Article            @relation(fields: [articleId], references: [id])
  lieuId        Int
  lieu          Lieu               @relation(fields: [lieuId], references: [id])
  type          TypeMouvementStock
  quantite      Int                // + ou -
  stockAvant    Int
  stockApres    Int
  utilisateurId Int
  utilisateur   Utilisateur        @relation(fields: [utilisateurId], references: [id])
  refVenteId    Int?
  refVente      Vente?             @relation(fields: [refVenteId], references: [id])
  notes         String?
  createdAt     DateTime           @default(now())
}

// ------------------------------------------------------------
// CLIENTS
// ------------------------------------------------------------

model Client {
  id            Int      @id @default(autoincrement())
  nomComplet    String
  telephone     String?  @unique
  email         String?
  pointsFidelite Int     @default(0)

  achatsConsecutifs       Int     @default(0)
  montantCumuleConsecutif Decimal @default(0)

  createdAt     DateTime @default(now())

  ventes        Vente[]
  listesCadeau  ListeCadeau[]
  recompensesFidelite RecompenseFidelite[]
}

enum TypeRecompenseFidelite {
  A_DEFINIR
  REMISE
  ARTICLE
  AUTRE
}

enum StatutRecompenseFidelite {
  EN_ATTENTE
  DEFINIE
  UTILISEE
}

model RecompenseFidelite {
  id             Int                      @id @default(autoincrement())
  clientId       Int
  client         Client                   @relation(fields: [clientId], references: [id])
  montantCumule  Decimal
  type           TypeRecompenseFidelite   @default(A_DEFINIR)
  articleOffertId Int?
  valeurRemise   Decimal?
  description    String?
  statut         StatutRecompenseFidelite @default(EN_ATTENTE)
  dateAtteinte   DateTime                 @default(now())
  dateUtilisation DateTime?
}

// ------------------------------------------------------------
// VENDEURS (distincts des caissiers, comme à La Pointure)
// ------------------------------------------------------------

model Vendeur {
  id        Int      @id @default(autoincrement())
  nomComplet String
  telephone String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  ventes    Vente[]
}

// ------------------------------------------------------------
// VENTES (avec annulation + réversion de stock, crédit, échanges)
// ------------------------------------------------------------

enum StatutVente {
  VALIDEE
  ANNULEE
}

enum TypeVente {
  COMPTANT
  CREDIT
}

model Vente {
  id             Int          @id @default(autoincrement())
  numero         String       @unique
  clientId       Int?
  client         Client?      @relation(fields: [clientId], references: [id])
  utilisateurId  Int
  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id])
  vendeurId      Int?
  vendeur        Vendeur?     @relation(fields: [vendeurId], references: [id])
  lieuId         Int
  lieu           Lieu         @relation(fields: [lieuId], references: [id])
  statut         StatutVente  @default(VALIDEE)
  typeVente      TypeVente    @default(COMPTANT)
  totalHT        Decimal
  remiseMontant  Decimal      @default(0)
  totalNet       Decimal
  modePaiement   String?
  carteCadeauUtiliseeId Int?
  carteCadeauUtilisee   CarteCadeau? @relation(fields: [carteCadeauUtiliseeId], references: [id])
  dateAnnulation DateTime?
  motifAnnulation String?
  createdAt      DateTime     @default(now())

  lignes         LigneVente[]
  mouvementsStock MouvementStock[]
  demandesRemise DemandeRemise[]
  paiements      PaiementVente[]
  reglements     ReglementCredit[]
  echangesOrigine Echange[]
}

model LigneVente {
  id          Int     @id @default(autoincrement())
  venteId     Int
  vente       Vente   @relation(fields: [venteId], references: [id])
  articleId   Int
  article     Article @relation(fields: [articleId], references: [id])
  quantite    Int
  prixUnitaire Decimal
  remiseLigne Decimal @default(0)
}

// Demande de remise en temps réel avec approbation à distance (comme La Pointure)
enum StatutDemandeRemise {
  EN_ATTENTE
  APPROUVEE
  REFUSEE
}

model DemandeRemise {
  id             Int                 @id @default(autoincrement())
  venteId        Int
  vente          Vente               @relation(fields: [venteId], references: [id])
  demandeurId    Int
  demandeur      Utilisateur         @relation("DemandeurRemise", fields: [demandeurId], references: [id])
  montantDemande Decimal
  motif          String?
  statut         StatutDemandeRemise @default(EN_ATTENTE)
  approbateurId  Int?
  approbateur    Utilisateur?        @relation("ApprobateurRemise", fields: [approbateurId], references: [id])
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?
}

// ------------------------------------------------------------
// RÈGLEMENTS DE CRÉDIT (paiements reçus après la vente à crédit)
// Pas de date d'échéance : on suit juste ce qui a déjà été payé.
// Montant restant dû = Vente.totalNet - somme(PaiementVente) - somme(ReglementCredit)
// ------------------------------------------------------------

model ReglementCredit {
  id            Int         @id @default(autoincrement())
  venteId       Int
  vente         Vente       @relation(fields: [venteId], references: [id])
  montant       Decimal
  mode          String      // Espèces, Moov Money, Wave...
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  createdAt     DateTime    @default(now())
}

// ------------------------------------------------------------
// RETOURS / ÉCHANGES
// Jamais de remboursement en espèces : le client reprend au moins un article
// de valeur équivalente. Si les nouveaux articles coûtent plus cher, il paie
// la différence. Si c'est moins cher, la différence est perdue (pas d'avoir gardé).
// ------------------------------------------------------------

model Echange {
  id              Int          @id @default(autoincrement())
  reference       String       @unique
  venteOrigineId  Int?         // vente d'origine si connue/retrouvée
  venteOrigine    Vente?       @relation(fields: [venteOrigineId], references: [id])
  lieuId          Int
  lieu            Lieu         @relation(fields: [lieuId], references: [id])
  valeurReprise   Decimal      // valeur totale des articles repris
  valeurNouveaux  Decimal      // valeur totale des nouveaux articles pris
  montantAPayer   Decimal      @default(0) // max(0, valeurNouveaux - valeurReprise)
  utilisateurId   Int
  utilisateur     Utilisateur  @relation(fields: [utilisateurId], references: [id])
  createdAt       DateTime     @default(now())

  articlesRepris   LigneEchangeRepris[]
  articlesNouveaux LigneEchangeNouveau[]
  paiements        PaiementEchange[]
}

model LigneEchangeRepris {
  id           Int     @id @default(autoincrement())
  echangeId    Int
  echange      Echange @relation(fields: [echangeId], references: [id])
  articleId    Int
  article      Article @relation(fields: [articleId], references: [id])
  quantite     Int
  prixUnitaire Decimal
}

model LigneEchangeNouveau {
  id           Int     @id @default(autoincrement())
  echangeId    Int
  echange      Echange @relation(fields: [echangeId], references: [id])
  articleId    Int
  article      Article @relation(fields: [articleId], references: [id])
  quantite     Int
  prixUnitaire Decimal
}

model PaiementEchange {
  id        Int      @id @default(autoincrement())
  echangeId Int
  echange   Echange  @relation(fields: [echangeId], references: [id])
  mode      String
  montant   Decimal
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// CARTES CADEAUX RÉUTILISABLES
// ------------------------------------------------------------

model DenominationCarteCadeau {
  id       Int    @id @default(autoincrement())
  montant  Decimal @unique
  actif    Boolean @default(true)
}

enum StatutCarteCadeau {
  INACTIVE
  ACTIVE
  UTILISEE
}

model CarteCadeau {
  id            Int               @id @default(autoincrement())
  codeBarre     String            @unique
  denomination  Decimal
  statut        StatutCarteCadeau @default(INACTIVE)
  createdAt     DateTime          @default(now())

  cycles        CarteCadeauCycle[]
  ventes        Vente[]
  listesCadeauOfferts ListeCadeauCarteUtilisee[]
}

model CarteCadeauCycle {
  id             Int          @id @default(autoincrement())
  carteCadeauId  Int
  carteCadeau    CarteCadeau  @relation(fields: [carteCadeauId], references: [id])
  denomination   Decimal
  dateActivation DateTime     @default(now())
  dateUtilisation DateTime?
  utilisateurId  Int
  utilisateur    Utilisateur  @relation("ActivateurCycle", fields: [utilisateurId], references: [id])
}

// ------------------------------------------------------------
// LISTES CADEAUX
// ------------------------------------------------------------

model ListeCadeau {
  id            Int      @id @default(autoincrement())
  clientId      Int
  client        Client   @relation(fields: [clientId], references: [id])
  titre         String?
  codeAcces     String   @unique
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now())

  nomDestinataire        String?
  telephoneDestinataire1 String?
  telephoneDestinataire2 String?
  emailDestinataire      String?

  nomDonateur       String?
  telephoneDonateur String?
  emailDonateur     String?

  lignes        LigneListeCadeau[]
  cartesUtilisees ListeCadeauCarteUtilisee[]
}

model LigneListeCadeau {
  id            Int         @id @default(autoincrement())
  listeCadeauId Int
  listeCadeau   ListeCadeau @relation(fields: [listeCadeauId], references: [id])
  articleId     Int
  article       Article     @relation(fields: [articleId], references: [id])
  quantiteSouhaitee Int
  quantiteOfferte   Int     @default(0)

  detailsOffres DetailOffreListeCadeau[]
}

enum StatutConfirmationOffre {
  CONFIRME
  EN_ATTENTE_VERIFICATION
  REJETE
}

model ListeCadeauCarteUtilisee {
  id             Int                      @id @default(autoincrement())
  listeCadeauId  Int
  listeCadeau    ListeCadeau              @relation(fields: [listeCadeauId], references: [id])
  carteCadeauId  Int?
  carteCadeau    CarteCadeau?             @relation(fields: [carteCadeauId], references: [id])
  modePaiement   String?
  offrePar       String?
  canal          String
  montantUtilise Decimal
  statutConfirmation StatutConfirmationOffre @default(CONFIRME)
  validateurId   Int?
  validateur     Utilisateur?             @relation("ValidateurOffre", fields: [validateurId], references: [id])
  dateValidation DateTime?
  createdAt      DateTime                 @default(now())

  lignesCouvertes DetailOffreListeCadeau[]
}

model DetailOffreListeCadeau {
  id                  Int                      @id @default(autoincrement())
  offreId             Int
  offre               ListeCadeauCarteUtilisee @relation(fields: [offreId], references: [id])
  ligneListeCadeauId  Int
  ligneListeCadeau    LigneListeCadeau         @relation(fields: [ligneListeCadeauId], references: [id])
  quantite            Int
}

// ------------------------------------------------------------
// DÉPENSES / BUDGET (13 catégories, visibilité par rôle)
// ------------------------------------------------------------

model CategorieDepense {
  id       Int    @id @default(autoincrement())
  nom      String @unique
  depenses Depense[]
}

model Depense {
  id             Int              @id @default(autoincrement())
  categorieId    Int
  categorie      CategorieDepense @relation(fields: [categorieId], references: [id])
  montant        Decimal
  description    String?
  utilisateurId  Int
  utilisateur    Utilisateur      @relation(fields: [utilisateurId], references: [id])
  dateDepense    DateTime         @default(now())
  createdAt      DateTime         @default(now())
}

// ------------------------------------------------------------
// PAIEMENTS DE VENTE (paiement mixte : plusieurs modes possibles)
// ------------------------------------------------------------

model PaiementVente {
  id        Int      @id @default(autoincrement())
  venteId   Int
  vente     Vente    @relation(fields: [venteId], references: [id])
  mode      String
  montant   Decimal
  createdAt DateTime @default(now())
}